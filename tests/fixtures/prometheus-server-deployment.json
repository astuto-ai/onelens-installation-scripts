{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "labels": {
      "app.kubernetes.io/component": "server",
      "app.kubernetes.io/name": "prometheus",
      "app.kubernetes.io/instance": "onelens-agent",
      "app.kubernetes.io/version": "v3.1.0",
      "helm.sh/chart": "prometheus-27.3.0",
      "app.kubernetes.io/part-of": "prometheus"
    },
    "name": "onelens-agent-prometheus-server",
    "namespace": "onelens-agent"
  },
  "spec": {
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/component": "server",
        "app.kubernetes.io/name": "prometheus",
        "app.kubernetes.io/instance": "onelens-agent"
      }
    },
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "strategy": {
      "type": "Recreate",
      "rollingUpdate": null
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/component": "server",
          "app.kubernetes.io/name": "prometheus",
          "app.kubernetes.io/instance": "onelens-agent",
          "app.kubernetes.io/version": "v3.1.0",
          "helm.sh/chart": "prometheus-27.3.0",
          "app.kubernetes.io/part-of": "prometheus"
        }
      },
      "spec": {
        "enableServiceLinks": true,
        "serviceAccountName": "onelens-agent-prometheus-server",
        "containers": [
          {
            "name": "prometheus-server-configmap-reload",
            "image": "public.ecr.aws/w7k6q5m9/onelens-prometheus-config-reloader:v0.95.2",
            "imagePullPolicy": "IfNotPresent",
            "args": [
              "--watched-dir=/etc/config",
              "--listen-address=0.0.0.0:8080",
              "--reload-url=http://127.0.0.1:9090/-/reload"
            ],
            "ports": [
              {
                "containerPort": 8080,
                "name": "metrics"
              }
            ],
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "metrics",
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 2,
              "periodSeconds": 10
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "metrics",
                "scheme": "HTTP"
              },
              "periodSeconds": 10
            },
            "resources": {
              "limits": {
                "cpu": "100m",
                "memory": "100Mi"
              },
              "requests": {
                "cpu": "100m",
                "memory": "100Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "config-volume",
                "mountPath": "/etc/config",
                "readOnly": true
              }
            ]
          },
          {
            "name": "prometheus-server",
            "image": "public.ecr.aws/w7k6q5m9/onelens-prometheus:v3.13.5",
            "imagePullPolicy": "IfNotPresent",
            "args": [
              "--storage.tsdb.retention.time=30d",
              "--storage.tsdb.retention.size=6GB",
              "--config.file=/etc/config/prometheus.yml",
              "--storage.tsdb.path=/data",
              "--web.console.libraries=/etc/prometheus/console_libraries",
              "--web.console.templates=/etc/prometheus/consoles",
              "--web.enable-lifecycle",
              "--storage.tsdb.max-block-duration=2h",
              "--storage.tsdb.min-block-duration=30m"
            ],
            "ports": [
              {
                "containerPort": 9090
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/-/ready",
                "port": 9090,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 30,
              "periodSeconds": 5,
              "timeoutSeconds": 4,
              "failureThreshold": 3,
              "successThreshold": 1
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/-/healthy",
                "port": 9090,
                "scheme": "HTTP"
              },
              "initialDelaySeconds": 30,
              "periodSeconds": 15,
              "timeoutSeconds": 10,
              "failureThreshold": 3,
              "successThreshold": 1
            },
            "volumeMounts": [
              {
                "name": "config-volume",
                "mountPath": "/etc/config"
              },
              {
                "name": "storage-volume",
                "mountPath": "/data",
                "subPath": ""
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "securityContext": {
          "fsGroup": 65534,
          "runAsGroup": 65534,
          "runAsNonRoot": true,
          "runAsUser": 65534
        },
        "terminationGracePeriodSeconds": 300,
        "volumes": [
          {
            "name": "config-volume",
            "configMap": {
              "name": "onelens-agent-prometheus-server"
            }
          },
          {
            "name": "storage-volume",
            "persistentVolumeClaim": {
              "claimName": "onelens-agent-prometheus-server"
            }
          }
        ]
      }
    }
  }
}
